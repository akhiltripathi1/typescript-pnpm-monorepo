{
  "name": "my-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --recursive --sort build && pnpm --parallel --filter @repo/web --filter @repo/api dev",
    "build": "pnpm --recursive --sort build",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "build:web": "pnpm --filter @repo/web build",
    "build:api": "pnpm --filter @repo/api build",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@12.18.0"
}
